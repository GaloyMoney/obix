#!/usr/bin/env bash
set -e
if [[ ! -d "/Users/jcarter/projects/galoymoney/obix/.claude/worktrees/obix-partition-persistent-outbox-019fc7ad" ]]; then
  echo "Cannot find source directory; Did you move it?"
  echo "(Looking for "/Users/jcarter/projects/galoymoney/obix/.claude/worktrees/obix-partition-persistent-outbox-019fc7ad")"
  echo 'Cannot force reload with this script - use "direnv reload" manually and then try again'
  exit 1
fi

# rebuild the cache forcefully
_nix_direnv_force_reload=1 direnv exec "/Users/jcarter/projects/galoymoney/obix/.claude/worktrees/obix-partition-persistent-outbox-019fc7ad" true

# Update the mtime for .envrc.
# This will cause direnv to reload again - but without re-building.
touch "/Users/jcarter/projects/galoymoney/obix/.claude/worktrees/obix-partition-persistent-outbox-019fc7ad/.envrc"

# Also update the timestamp of whatever profile_rc we have.
# This makes sure that we know we are up to date.
touch -r "/Users/jcarter/projects/galoymoney/obix/.claude/worktrees/obix-partition-persistent-outbox-019fc7ad/.envrc" "/Users/jcarter/projects/galoymoney/obix/.claude/worktrees/obix-partition-persistent-outbox-019fc7ad/.direnv"/*.rc
