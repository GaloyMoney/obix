{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT sequence AS \"sequence!: i64\", id AS \"id!\", payload, tracing_context, event_context, recorded_at AS \"recorded_at!\", commit_xid\n            FROM persistent_outbox_events\n            WHERE sequence > $1\n              AND sequence <= $1 + $2\n            ORDER BY sequence ASC\n            LIMIT $2",
