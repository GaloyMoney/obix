  "query": "\n            SELECT sequence AS \"sequence!: i64\", commit_xid,\n                   (payload IS NOT NULL) AS \"has_payload!\"\n            FROM persistent_outbox_events\n            WHERE sequence > $1 AND sequence <= $1 + $2\n            ORDER BY sequence",
