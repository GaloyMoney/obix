  "query": "\n            SELECT commit_xid, sequence AS \"sequence!: i64\", id, payload,\n                   tracing_context, recorded_at\n            FROM persistent_outbox_events\n            WHERE commit_xid = ANY($1) AND sequence >= $2 AND payload IS NOT NULL\n            ORDER BY commit_xid, sequence",
